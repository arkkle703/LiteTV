<?xml version="1.0" encoding="utf-8"?>
<!-- 分段式频道选择页的整屏底：沿用侧栏原来的黑色渐变（bg_overlay_start → bg_overlay_end） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/bg_overlay_start"
        android:centerColor="@color/bg_overlay_start"
        android:endColor="@color/bg_overlay_end" />
</shape>
