<?xml version="1.0" encoding="utf-8"?>
<!-- 播放控制面板：底部整条，颜色与换台信息条一致 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="@color/bg_overlay_start"
        android:endColor="@color/bg_overlay_start" />
    <stroke android:width="1dp" android:color="@color/surface_card_stroke" />
    <corners android:topLeftRadius="@dimen/card_corner_radius"
        android:topRightRadius="@dimen/card_corner_radius" />
</shape>
